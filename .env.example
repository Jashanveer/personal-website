# ============================================================================
# Local environment variables
#
# Copy this file to `.env.local` and fill in any values you want to override.
# `.env.local` is git-ignored (see .gitignore — pattern `.env*`).
#
# The site runs without ANY of these set — they're all optional. Each one
# unlocks a feature when you provide it.
# ============================================================================


# ----------------------------------------------------------------------------
# GitHub username for the contributions heatmap on the GitHub section
# Hardcoded to "Jashanveer" right now in src/components/GitHub.tsx and
# GitHubHeatmap. If you fork this site for your own use, override here.
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_GITHUB_USERNAME=Jashanveer


# ----------------------------------------------------------------------------
# Contact form: real email backend
#
# By default the contact form opens the visitor's mail client via mailto:.
# To send mail directly from the page (no mail-app round-trip), wire up
# Resend (https://resend.com — free tier covers a personal site), then:
#   1) Set the two vars below.
#   2) Replace the onSubmit handler in src/components/Contact.tsx with a
#      fetch() to a Next.js API route that uses the Resend SDK.
# ----------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# CONTACT_TO_EMAIL=mailforjashanveer@gmail.com
